# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env ASLA commitlenmez.

# Postgres şifresi (sadece harf ve rakam kullanın, URL içinde geçiyor)
# Üretmek için: openssl rand -hex 24
POSTGRES_PASSWORD=

# JWT — üretmek için: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cloudflare R2
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=
